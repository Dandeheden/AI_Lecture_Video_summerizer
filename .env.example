# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite:///./backend/data/lectureai.db

# Speech Recognition Model (faster-whisper)
# Options: tiny, base, small, medium
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Summarization Model (Hugging Face)
# Options: sshleifer/distilbart-cnn-12-6, google/flan-t5-base, facebook/bart-large-cnn
DEFAULT_SUMMARIZATION_MODEL=sshleifer/distilbart-cnn-12-6

# File Upload Limit
MAX_UPLOAD_SIZE_MB=250
